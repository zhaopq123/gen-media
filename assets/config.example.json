{
  // 默认用哪一条，写下面某个 name
  "current": "我的服务",
  // 可以放多条，每条一个服务；只用一个就填第一条
  "providers": [
    {
      // 随便起个名字，自己认得出就行
      "name": "我的服务",
      // 密钥，服务商给你的那一串
      "api_key": "",
      // 生图接口的完整地址，照文档原样复制
      "image_url": "",
      // 视频接口的完整地址，照文档原样复制
      "video_url": "",
      // 视频查询地址，里面的 {id} 会替换成任务号
      "query_url": "",
      // 生图模型名，去服务商的模型列表里抄
      "image_model": "",
      // 视频模型名，只出图可以先留空
      "video_model": "",
      // 请求风格，填 auto、nested 或 openai，不确定就 auto
      "style": "auto"
    }
  ]
}
